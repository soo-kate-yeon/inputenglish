# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google Generative AI (Gemini)
# Used for comprehensible input reading generation and question agent.
# Gemini 2.5 Pro (generation) and Flash (question short answers via Flash-gate).
GEMINI_API_KEY=your_gemini_api_key

# Azure OpenAI (Fallback for reading generation)
# Optional. When set, reading-generation.ts falls back to Azure if Gemini fails.
# Get endpoint + key from Azure Portal > Azure OpenAI resource.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# Comprehensible Input — dev-only overrides
# READING_FIXTURE_MODE=true       # skip Gemini/Azure, return stub ReadingPiece
# READING_GENERATION_MODEL=gemini-2.5-pro  # override default model

# yt-dlp path (used by admin ingest route /api/admin/premium/ingest)
# Install: brew install yt-dlp  OR  pip install yt-dlp
# Defaults to "yt-dlp" on PATH if not set.
YT_DLP_PATH=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Sentry (Mobile)
# Create a React Native project at https://sentry.io, copy its DSN here.
# Leave empty to disable Sentry (app still runs fine).
EXPO_PUBLIC_SENTRY_DSN=

# Azure Speech Services (Web — pronunciation analysis)
# Required for /api/pronunciation/analyses. Without these, requests fail
# with AzurePronunciationError code=MISSING_CONFIG.
# Create a Speech resource at https://portal.azure.com and copy:
#   KEY 1 -> AZURE_SPEECH_KEY
#   Location/Region (lowercase, no spaces, e.g. koreacentral) -> AZURE_SPEECH_REGION
# In production these MUST be registered via `vercel env add`, not just .env.local.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
